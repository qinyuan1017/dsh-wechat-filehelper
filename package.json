{
  "name": "dsh-wechat-filehelper",
  "version": "0.2.1",
  "description": "微信文件传输助手网页版插件：让 agent 直接把文件/文本发到自己微信，全程不用打开网页。纯 HTTP 走 webwx 协议，扫码只需一次。",
  "type": "module",
  "main": "index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.4.0-0"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "scripts/",
    "src/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/protocol.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "filehelper",
    "weixin",
    "file-transfer"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
