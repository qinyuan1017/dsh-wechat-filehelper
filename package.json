{
  "name": "dsh-wechat-filehelper",
  "version": "0.2.1",
  "description": "微信文件传输助手网页版插件：让 agent 直接把文件/文本发到自己微信，全程不用打开网页。纯 HTTP 走 webwx 协议，扫码只需一次。",
  "type": "module",
  "main": "index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.4.0-0"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "scripts/",
    "src/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/protocol.test.mjs && node test/plugin.test.mjs && node test/rpc.test.mjs && node test/client.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dshmarket",
    "wechat",
    "weixin",
    "filehelper",
    "wechat-file-helper",
    "wechat-file-transfer",
    "file-transfer",
    "send-file",
    "send-to-wechat",
    "file-transfer-helper",
    "agent-tool",
    "ai-agent",
    "automation"
  ],
  "license": "MIT",
  "author": "qinyuan1017",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinyuan1017/dsh-wechat-filehelper.git"
  },
  "homepage": "https://github.com/qinyuan1017/dsh-wechat-filehelper#readme",
  "bugs": {
    "url": "https://github.com/qinyuan1017/dsh-wechat-filehelper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
